@{
    Layout = "~/Views/Shared/_AjaxLayout.cshtml";
}
@using Data.Model
@model IList<Cliente>
<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header card-header-danger">
                    <h4 class="card-title ">Clientes</h4>
                    <p class="card-category">@Model.Count() clientes encontrados</p>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead class=" text-primary">
                                <tr>
                                    <th>Nome Fantasia</th>
                                    <th>CNPJ</th>
                                    <th>Porte</th>
                                    <th>Ativo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cliente in this.Model)
                                {
                                    <tr>
                                        <td>
                                            @cliente.NomeFantasia
                                        </td>
                                        <td>
                                            @cliente.Cnpj
                                        </td>
                                        <td class="text-primary">
                                            @cliente.Porte.Nome
                                        </td>
                                        <td>
                                            @(cliente.Ativo ? "Sim" : "Não")
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-primary pull-right">Editar<div class="ripple-container"></div></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>    
    </div>
</div>